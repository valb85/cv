# JetBrains IDE settings (PhpStorm, IntelliJ)
.idea/
*.iml

# Node
node_modules/
.next/
.pnpm-store/

# Active compose config - .env.dev / .env.prod are the committed templates
/.env

# Runtime data: SQLite database and uploaded media.
# Bind-mount targets in prod, and container-created mount points in dev.
/data/
/apps/web-cv/data/
/apps/web-cv/uploads/

# Database exports. `dco cp` lands these in the repo root on the way to the
# server, and they hold the admin password hash and every contact message.
*.db
*.db-wal
*.db-shm

# TypeScript incremental build cache
*.tsbuildinfo
