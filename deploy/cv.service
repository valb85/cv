# Runs the Next.js standalone server. Apache reverse-proxies to it; this unit
# is what Docker's `restart: unless-stopped` used to provide.
#
#   sudo cp deploy/cv.service /etc/systemd/system/cv.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cv
#   systemctl status cv
#   journalctl -u cv -f

[Unit]
Description=CV site (Next.js)
After=network.target

[Service]
Type=simple
User=cv
Group=cv
WorkingDirectory=/srv/cv
EnvironmentFile=/etc/cv.env
ExecStart=/usr/bin/node /srv/cv/server.js
Restart=always
RestartSec=3
# Node exits 143 on the SIGTERM that `systemctl stop/restart` sends. That is
# a clean stop, not a failure - without this every restart logs "Failed".
SuccessExitStatus=143

# Creates and owns /var/lib/cv, which holds the database and uploads. Kept
# outside /srv/cv so a redeploy overwrites the app without touching the data.
StateDirectory=cv

# Everything else is read-only to the app, except one folder: next/image
# caches resized images in .next/cache (created by deploy/build.sh). Without
# it every image request is resized again and logs "Failed to write image to
# cache ... ENOENT". The leading "-" keeps the unit starting if the folder is
# ever missing - the cache is then simply off, as before.
ReadWritePaths=-/srv/cv/.next/cache
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
