# Copy to /etc/cv.env, fill in, then:
#   sudo chown root:cv /etc/cv.env && sudo chmod 640 /etc/cv.env
# It holds the session secret and the admin password, so it must not be
# world-readable.

NODE_ENV=production
ENVIRONMENT=prod

# Loopback only: Apache is the only thing that should reach the app. Without
# HOSTNAME the standalone server binds 0.0.0.0 and bypasses the vhost.
HOSTNAME=127.0.0.1
PORT=3000

APP_DOMAIN=cv.example.com
BASE_URL=https://cv.example.com

# Where the admin is reachable. The route files live at /admin internally and
# middleware rewrites this onto them, so /admin itself returns the same 404 as
# any other dead URL. One path segment, [a-z0-9_-], three characters or more;
# a malformed value takes the admin offline rather than falling back to /admin.
# Unset - as in local Docker development - means /admin.
#
#   openssl rand -hex 8
ADMIN_PATH=/console-CHANGEME

# Under StateDirectory=cv, systemd creates /var/lib/cv owned by the service
# user. SQLite runs in WAL mode, so the directory itself must be writable -
# it also creates cv.db-wal and cv.db-shm.
DATABASE_PATH=/var/lib/cv/cv.db
UPLOAD_DIR=/var/lib/cv/uploads

# openssl rand -hex 32
SESSION_SECRET=

# Used once, on first boot, to create the single admin account. Changing it
# later does not reset an existing password.
ADMIN_EMAIL=albulescu.victor.alexandru@gmail.com
ADMIN_PASSWORD=
