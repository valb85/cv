# Local HTTPS for development: https://cv.localhost
#
# Runs as a container in this stack (see docker-compose.dev.yml), not on the
# host, which is what makes it need no sudo at all:
#
#   * cv.localhost resolves to 127.0.0.1 natively - systemd-resolved and every
#     modern browser treat *.localhost as loopback per RFC 6761 - so there is
#     no /etc/hosts entry to add.
#   * The Docker daemon binds :443 on the host, so Caddy does not need root or
#     CAP_NET_BIND_SERVICE.
#   * Inside the container Caddy is free to use :80 for its HTTP->HTTPS
#     redirect; only :443 is published, so it never collides with the host
#     caddy service that already owns :80.
#
# `tls internal` issues from Caddy's own CA, kept in the caddy-data volume so
# the certificate survives a rebuild. The browser will warn until that CA is
# trusted - optional, and the only step that would need sudo:
#
#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt /tmp/cv-root.crt
#   sudo cp /tmp/cv-root.crt /usr/local/share/ca-certificates/cv-local.crt
#   sudo update-ca-certificates
#
# Upstream is the apache container by service name, so the request never
# leaves the compose network on its way in.

cv.localhost {
	tls internal

	reverse_proxy apache:80 {
		header_up Host               "cv.localhost"
		header_up X-Real-IP          {remote}
		header_up X-Forwarded-Host   "cv.localhost"
		header_up X-Forwarded-Server "cv.localhost"
		header_up X-Forwarded-Port   {port}
		header_up X-Forwarded-For    {remote}
		header_up X-Forwarded-Proto  {scheme}
	}
}
