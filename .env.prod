# shellcheck disable=SC2034
COMPOSE_PROJECT_NAME=cv
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

ENVIRONMENT="prod"
APP_DOMAIN="cv.example.com"
BASE_URL="https://${APP_DOMAIN}"

DATABASE_PATH="/srv/data/cv.db"
UPLOAD_DIR="/srv/uploads"

# Set before first boot. openssl rand -hex 32
SESSION_SECRET=
ADMIN_EMAIL="albulescu.victor.alexandru@gmail.com"
ADMIN_PASSWORD=

# -prod suffixed so a production build never clobbers the development image:
# with IMAGE_* empty, dev images take compose's default <project>-<service> name.
IMAGE_APACHE="${COMPOSE_PROJECT_NAME}-apache-prod:latest"
IMAGE_APACHE_BASE="httpd:2.4"
IMAGE_CV="${COMPOSE_PROJECT_NAME}-cv-prod:latest"
IMAGE_CV_BASE="${COMPOSE_PROJECT_NAME}-base:latest"
