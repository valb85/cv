# shellcheck disable=SC2034
COMPOSE_PROJECT_NAME=cv
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

ENVIRONMENT="dev"
APP_DOMAIN="cv.localhost"
BASE_URL="https://${APP_DOMAIN}"

DATABASE_PATH="/srv/data/cv.db"
UPLOAD_DIR="/srv/uploads"

# Contact form human check. These are Cloudflare's official TEST keys: the
# widget always passes and the server always accepts. Real keys go in prod.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Caddy + Apache sit in front of Node here - see src/lib/client-ip.ts.
TRUSTED_PROXY_HOPS=2

# Dev only. Generate a real one for prod: openssl rand -hex 32
SESSION_SECRET="dev-only-insecure-0123456789abcdef0123456789abcdef"
ADMIN_EMAIL="albulescu.victor.alexandru@gmail.com"
ADMIN_PASSWORD="admin"

IMAGE_APACHE=
IMAGE_APACHE_BASE="httpd:2.4"
IMAGE_CADDY_BASE="caddy:2-alpine"
IMAGE_CV=
IMAGE_CV_BASE="${COMPOSE_PROJECT_NAME}-base:latest"
