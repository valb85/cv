# shellcheck disable=SC2034
COMPOSE_PROJECT_NAME=cv
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

ENVIRONMENT="dev"
APP_DOMAIN="cv.localhost"
BASE_URL="https://${APP_DOMAIN}"

DATABASE_PATH="/srv/data/cv.db"
UPLOAD_DIR="/srv/uploads"

# Dev only. Generate a real one for prod: openssl rand -hex 32
SESSION_SECRET="dev-only-insecure-0123456789abcdef0123456789abcdef"
ADMIN_EMAIL="albulescu.victor.alexandru@gmail.com"
ADMIN_PASSWORD="admin"

SMTP_HOST="mailhog"
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER="noreply@cv.localhost"
EMAIL_RECIPIENT="albulescu.victor.alexandru@gmail.com"

IMAGE_APACHE=
IMAGE_APACHE_BASE="httpd:2.4"
IMAGE_CADDY_BASE="caddy:2-alpine"
IMAGE_CV=
IMAGE_CV_BASE="${COMPOSE_PROJECT_NAME}-base:latest"
